<%- include('partials/header') %>

<h1>Sign up</h1>

<% if (errors.length > 0) { %>
  <ul class="errors">
    <% errors.forEach(function(err) { %>
      <li><%= err.msg %></li>
    <% }); %>
  </ul>
<% } %>

<form action="/sign-up" method="POST" class="form">
  <label for="firstName">First name</label>
  <input type="text" id="firstName" name="firstName" value="<%= formData.firstName || '' %>" required />

  <label for="lastName">Last name</label>
  <input type="text" id="lastName" name="lastName" value="<%= formData.lastName || '' %>" required />

  <label for="email">Email (used as your username)</label>
  <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required />

  <label for="password">Password</label>
  <input type="password" id="password" name="password" required minlength="6" />

  <label for="confirmPassword">Confirm password</label>
  <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6" />

  <label class="checkbox-label">
    <input type="checkbox" name="isAdmin" <%= formData.isAdmin ? 'checked' : '' %> />
    Sign up as an admin (for testing &mdash; a real app wouldn't do this!)
  </label>

  <button type="submit">Create account</button>
</form>

<p>Already have an account? <a href="/log-in">Log in</a></p>

<%- include('partials/footer') %>
